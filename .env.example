# Copy to .env (gitignored) and fill in.
# Demo and production keys are separate accounts and separate variables, so a
# demo config can never pick up production credentials.

# Demo: create keys at https://demo.kalshi.co -> Account & security -> API keys
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=secrets/demo.key

# Production: https://kalshi.com -> Account & security -> API keys
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=secrets/prod.key

# Optional: override the API base URL (normally derived from `environment`)
# KALSHI_API_URL=
